---
import ContentSection from "~/components/content-section.astro";
import { wedding } from "~/wedding.config";

const { lines, signature } = wedding.invitations.wedding;
---

<ContentSection id="wedding">
  <Fragment slot="pre-content">
    <div class="letter-pocket text-3xl">
      <br />
      {
        lines.map((line) => (
          <Fragment>
            <p class="text-center">{line}</p>
            <br />
          </Fragment>
        ))
      }
      {
        signature && (
          <Fragment>
            <br />
            <p class="text-left">{signature}</p>
          </Fragment>
        )
      }
      <br />
    </div>
  </Fragment>
</ContentSection>

<style>
  * {
    line-height: 3.5rem;
  }
</style>
