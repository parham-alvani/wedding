---
import ContentSection from "~/components/content-section.astro";
import { wedding } from "~/wedding.config";

const { lines, signature } = wedding.invitations.engagement;
---

<ContentSection id="engagement">
  <Fragment slot="pre-content">
    <div class="letter-pocket text-3xl">
      <br />
      {
        lines.map((line, i) => (
          <Fragment>
            <p class={i % 2 === 0 ? "text-right" : "text-left"}>&nbsp; {line}</p>
            <br />
            <br />
          </Fragment>
        ))
      }
      {signature && <p class="text-left">{signature}</p>}
    </div>
  </Fragment>
</ContentSection>
