---
import { Icon } from "astro-icon/components";
import HeroImage from "~/components/hero-image.astro";
import type { FooterLink } from "~/types";
import { wedding } from "~/wedding.config";

const { husband, wife } = wedding.couple;

function linksFor(person: typeof husband): Array<FooterLink> {
  const who = `${person.name} ${person.lastName}`;

  return [
    {
      url: person.socials.github,
      description: `${who}'s Github`,
      icon: "skill-icons:github-light",
    },
    {
      url: person.socials.instagram,
      description: `${who}'s Instagram`,
      icon: "skill-icons:instagram",
    },
  ];
}

const people = [husband, wife].map((person) => ({
  person,
  links: linksFor(person),
}));
---

<footer
  class="relative flex flex-col items-center justify-center gap-8 py-10 sm:h-64 sm:flex-row sm:gap-24 sm:py-0"
>
  <div class="absolute inset-0 overflow-hidden opacity-40">
    <HeroImage />
  </div>
  {
    people.map(({ person, links }) => (
      <ul class="relative flex items-center gap-3 sm:gap-4">
        <li>
          <span class="flex flex-col items-center justify-center text-center">
            {person.name}
            <span>{person.emoji}</span>
          </span>
        </li>
        {links.map((link) => (
          <li>
            <a
              class="flex size-12 items-center justify-center sm:size-16"
              href={link.url}
            >
              <span class="sr-only">{link.description}</span>
              <Icon class="size-full" name={link.icon} />
            </a>
          </li>
        ))}
      </ul>
    ))
  }
</footer>
