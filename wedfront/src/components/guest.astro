---
import { Icon } from "astro-icon/components";
import ContentSection from "~/components/content-section.astro";
import Extras from "~/components/extras.astro";
import type { Guest } from "~/types";
import { wedding } from "~/wedding.config";

export interface Props {
  guest: Guest;
  /** True once the RSVP deadline has passed; the backend enforces it too. */
  closed?: boolean;
}

const { guest, closed = false } = Astro.props;
const { husband, wife } = wedding.couple;
const { body, signOff, rsvp, rsvpClosed, changeHint, addToCalendar, extras } = wedding.guestLetter;

const anyExtras = extras.dietary.enabled || extras.song.enabled;

const greeting =
  guest.spouse_first_name == null
    ? `Dear ${guest.first_name},`
    : `Dear ${guest.first_name} & ${guest.spouse_first_name}`;

const answered = guest.answer != null;
// An answered guest may still change their mind until the deadline; only a
// closed RSVP locks the form.
const locked = closed;

// Answered guests keep an actionable button until the RSVP closes, so the
// label has to say what pressing it will do.
const label = locked ? rsvp.submitted : answered ? rsvp.update : rsvp.submit;
---

<ContentSection id="guest">
  <Fragment slot="pre-content">
    <p class="letter-pocket text-3xl">
      {greeting}
      <br />
      <br />
      &nbsp; {body}<br />
      <br />
      {signOff} <br />
      {wife.name} & {husband.name}
    </p>
  </Fragment>
  {
    guest.is_family != true ? (
      <Fragment slot="lead">
        <h2 class="gradient-text text-center font-extrabold tracking-tight text-8xl">
          {rsvp.heading}
        </h2>
        {locked && <p class="mx-auto my-4 w-5/6 text-center">{rsvpClosed}</p>}
        <fieldset
          class="mx-auto my-5 flex w-5/6 flex-row justify-center"
          aria-label={rsvp.heading}
        >
          <div class="mx-5 flex basis-1/2 flex-col gap-5 text-left">
            <label>
              <input
                type="radio"
                id="coming"
                name="coming"
                value="true"
                checked={guest.answer?.coming === true}
                disabled={locked}
              />
              {rsvp.accept}
            </label>
            <label>
              <input
                type="radio"
                value="false"
                name="coming"
                id="not-coming"
                checked={guest.answer?.coming === false}
                disabled={locked}
              />
              {rsvp.decline}
            </label>
          </div>

          {guest.spouse_first_name == null && (
            <div class="mx-5 basis-1/2 text-right">
              <input
                type="checkbox"
                id="plus_one"
                name="plus_one"
                checked={guest.answer?.plus_one === true}
                disabled={locked}
              />
              <label for="plus_one">{rsvp.plusOne}</label>
            </div>
          )}
        </fieldset>
        <Extras guest={guest} locked={locked} />
        <button
          type="button"
          data-id={guest.id}
          id="submit"
          disabled={locked}
          class="w-5/6 text-center lg:w-1/4"
          aria-label={label}
        >
          {label}
          <Icon
            name={answered ? "mdi:love-letter" : "mdi:love-letter-open"}
            class="inline size-12"
          />
        </button>
        {answered && !locked && (
          <p class="mx-auto mt-3 w-5/6 text-center text-base">{changeHint}</p>
        )}
        <p class="mt-4 text-center text-base">
          <a href="/wedding.ics" download>
            {addToCalendar}
          </a>
        </p>
      </Fragment>
    ) : (
      anyExtras && (
        <Fragment slot="lead">
          <h2 class="text-center font-extrabold tracking-tight text-4xl">
            {extras.familyHeading}
          </h2>
          <Extras guest={guest} locked={locked} />
          <button
            type="button"
            data-id={guest.id}
            data-family="true"
            id="submit"
            disabled={locked}
            class="w-5/6 text-center lg:w-1/4"
          >
            {extras.familySubmit}
            <Icon name="mdi:love-letter-open" class="inline size-12" />
          </button>
          <p class="mt-4 text-center text-base">
            <a href="/wedding.ics" download>
              {addToCalendar}
            </a>
          </p>
        </Fragment>
      )
    )
  }
</ContentSection>

<script>
  const submitBtn = document.getElementById("submit");
  if (submitBtn != null) {
    const id = submitBtn.getAttribute("data-id");

    const value = (elementId: string) =>
      (document.getElementById(elementId) as HTMLInputElement | null)?.value ?? "";

    const submit = () => {
      const comingChk = document.getElementById("coming") as HTMLInputElement;
      const plusOneChk = document.getElementById(
        "plus_one",
      ) as HTMLInputElement;
      // Family guests have no coming/declining question: they are attending.
      const isFamily = submitBtn.getAttribute("data-family") === "true";

      submitBtn.setAttribute("disabled", "true");

      fetch(`/api/guest/${id}/answer`, {
        method: "POST",
        body: JSON.stringify({
          coming: isFamily ? true : comingChk.checked,
          // Family guests have no plus-one control and must not claim one:
          // Guest.PlusOne already grants it to those with a partner, and
          // sending true here would count a single guest as two.
          // For everyone else, a missing control means a couple's page.
          plus_one: isFamily
            ? false
            : plusOneChk == null
              ? true
              : plusOneChk.checked,
          dietary: value("dietary"),
          song: value("song"),
        }),
        headers: {
          "Content-Type": "application/json",
        },
      })
        .then((resp) => {
          if (!resp.ok) throw new Error("Failed to submit RSVP");
          window.location.reload();
        })
        .catch(() => {
          submitBtn.removeAttribute("disabled");
          alert("Something went wrong. Please try again.");
        });
    };

    submitBtn.onclick = submit;
  }
</script>

<style>
  #submit {
    background-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
    padding: 0.5rem;
    border-radius: 10px;
  }

  #submit:disabled {
    opacity: 0.75;
  }
</style>
