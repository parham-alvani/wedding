---
import { Icon } from "astro-icon/components";
import HeroImage from "~/components/hero-image.astro";
import { wedding } from "~/wedding.config";

export interface Props {
  /** ISO date the countdown runs to. Empty renders no counter. */
  since: string;
  /** BCP-47 tag. Anything other than "en" uses the couple's local names. */
  lang?: string;
}

const { since, lang = "en" } = Astro.props;
const { husband, wife } = wedding.couple;
const local = lang !== "en";
---

<section class="relative h-full">
  <div id="splash-bg-fallback" class="absolute inset-0 w-full">
    <HeroImage />
  </div>
  <div class="relative flex h-full items-center justify-center">
    <h2 class="flex flex-col items-center self-auto">
      <Icon name="wedding" class="size-24 pb-5 text-primary md:size-32" />
      <div
        class="gradient-text text-center font-extrabold tracking-tighter text-8xl"
      >
        {
          local ? (
            <Fragment>
              {wife.nameLocal}
              <br /> و
              <br /> {husband.nameLocal}
            </Fragment>
          ) : (
            <Fragment>
              {wife.name}
              <br /> and,
              <br /> {husband.name}
            </Fragment>
          )
        }
        {
          since && (
            <Fragment>
              <br />
              <br />
              <astro-count-down data-since={since} data-lang={lang}>
                <span />
              </astro-count-down>
            </Fragment>
          )
        }
      </div>
    </h2>
  </div>
</section>

<noscript>
  <style>
    #splash-bg-fallback {
      display: block;
    }
  </style>
</noscript>

<script>
  class AstroCountDown extends HTMLElement {
    private weddingDate: number;
    private lang: string;

    private static readonly SECOND = 1000;
    private static readonly MINUTE = 60 * AstroCountDown.SECOND;
    private static readonly HOUR = 60 * AstroCountDown.MINUTE;
    private static readonly DAY = 24 * AstroCountDown.HOUR;

    private pad(n: number): string {
      // Locale digits (e.g. Persian) still need padding to two characters.
      return n.toLocaleString(this.lang).padStart(2, (0).toLocaleString(this.lang));
    }

    private render() {
      const counter = this.querySelector("span");
      if (counter == null) return;

      const diff = this.weddingDate - Date.now();

      if (diff > 0) {
        const days = Math.floor(diff / AstroCountDown.DAY);
        const hours = Math.floor((diff % AstroCountDown.DAY) / AstroCountDown.HOUR);
        const minutes = Math.floor((diff % AstroCountDown.HOUR) / AstroCountDown.MINUTE);
        const seconds = Math.floor((diff % AstroCountDown.MINUTE) / AstroCountDown.SECOND);

        counter.textContent = [days, hours, minutes, seconds]
          .map((n) => this.pad(n))
          .join(":");
        return;
      }

      const elapsed = Math.floor(-diff / AstroCountDown.DAY);
      counter.textContent =
        this.lang === "en"
          ? `${elapsed} days since our special day`
          : `${elapsed.toLocaleString(this.lang)} روز از آن روز گذشت`;
    }

    constructor() {
      super();

      this.lang = this.getAttribute("data-lang") ?? "en";
      const since = this.getAttribute("data-since");
      this.weddingDate = since != null ? new Date(since).getTime() : 0;

      if (since != null) {
        this.render();
        setInterval(() => this.render(), AstroCountDown.SECOND);
      }
    }
  }
  customElements.define("astro-count-down", AstroCountDown);
</script>
