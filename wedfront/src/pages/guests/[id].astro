---
import { config } from "astro.config";
import GuestSection from "~/components/guest.astro";
import Splash from "~/components/splash.astro";
import Venue from "~/components/venue.astro";
import Base from "~/layouts/Base.astro";
import type { Guest } from "~/types";
import { wedding } from "~/wedding.config";

const { id } = Astro.params;

const resp = await fetch(`${config.backend_url}/guest/${id}`);
if (!resp.ok) {
  return Astro.redirect("/");
}

const guest: Guest = await resp.json();

// The backend owns the deadline; asking it keeps the two from drifting apart.
// If the lookup fails the form stays open — the POST is still checked there.
let closed = false;
try {
  const rsvp = await fetch(`${config.backend_url}/rsvp`);
  if (rsvp.ok) {
    closed = ((await rsvp.json()) as { closed?: boolean }).closed === true;
  }
} catch {
  closed = false;
}
---

<Base title={guest.first_name}>
  <Splash since={wedding.dates.wedding} />
  <div class="columns-1 px-8 py-8">
    <GuestSection guest={guest} closed={closed} />
    <Venue id="wedding-venue" venue={wedding.venues.wedding} />
  </div>
  <script>
    setTimeout(() => {
      document.getElementById("guest")?.scrollIntoView({ behavior: "smooth" });
    }, 1500);
  </script>
</Base>
