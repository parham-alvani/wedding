---
import Invitation from "~/components/engaged.astro";
import Player from "~/components/player.astro";
import Splash from "~/components/splash.astro";
import Venue from "~/components/venue.astro";
import Base from "~/layouts/Base.astro";
import { wedding } from "~/wedding.config";

const { lang, dir } = wedding.ceremony;
---

<Base lang={lang} dir={dir}>
  <Splash since={wedding.dates.engaged} lang={lang} />
  <Player music={wedding.music.engaged} />
  <div class="columns-1 px-8 py-8">
    <Invitation />
    <Venue id="engagement-venue" venue={wedding.venues.engagement} local />
  </div>
</Base>
