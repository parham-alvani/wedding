# Wedding Backend (Go)

# Build the binary
build:
    go build -o wedback ./cmd/wedback

# Start the server
serve: build
    ./wedback serve

# Run all tests
test:
    go test -v -race ./...

# Run tests with coverage
cover:
    go test -coverprofile=coverage.out ./...
    go tool cover -html=coverage.out -o coverage.html

# Run linter
lint:
    golangci-lint run --timeout=30m

# Insert a new guest (interactive TUI)
insert: build
    ./wedback insert

# List all guests
list: build
    ./wedback list

# List only the guests who have not replied yet
waiting: build
    ./wedback list --waiting

# Render each guest's invitation message and personal RSVP link
invite *args: build
    ./wedback invite {{args}}

# Render invitations only for guests who have not replied yet
remind: build
    ./wedback invite --waiting

# Write a QR code per guest into the given directory
qr dir="qr": build
    ./wedback invite --qr-dir "{{dir}}"

# Clear a guest's RSVP so they can answer again
reset id: build
    ./wedback reset "{{id}}"

# Show dietary requirements and song requests left with the RSVPs
notes *args: build
    ./wedback notes {{args}}

# Bulk import guests from a CSV file
import file: build
    ./wedback import "{{file}}"

# Parse a CSV file and report what would be imported, without writing
import-check file: build
    ./wedback import --dry-run "{{file}}"

# Export every guest and their RSVP as CSV (stdout when no file is given)
export file="": build
    ./wedback export "{{file}}"

# Clean build artifacts
clean:
    rm -f wedback coverage.out coverage.html

# Update Go dependencies to latest versions
update:
    go get -u ./...
    go mod tidy
