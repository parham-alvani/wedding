# Wedding Backend (Go)

# Build the binary
build:
    go build -o wedback ./cmd/wedback

# Start the server
serve: build
    ./wedback serve

# Run all tests
test:
    go test -v -race ./...

# Run tests with coverage
cover:
    go test -coverprofile=coverage.out ./...
    go tool cover -html=coverage.out -o coverage.html

# Run linter
lint:
    golangci-lint run --timeout=30m

# Insert a new guest (interactive TUI)
insert: build
    ./wedback insert

# List all guests
list: build
    ./wedback list

# Bulk import guests from a CSV file
import file: build
    ./wedback import "{{file}}"

# Parse a CSV file and report what would be imported, without writing
import-check file: build
    ./wedback import --dry-run "{{file}}"

# Export every guest and their RSVP as CSV (stdout when no file is given)
export file="": build
    ./wedback export "{{file}}"

# Clean build artifacts
clean:
    rm -f wedback coverage.out coverage.html

# Update Go dependencies to latest versions
update:
    go get -u ./...
    go mod tidy
